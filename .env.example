# ---------- Pflicht ----------
# Öffentliche HTTPS-Adresse deines VPS (für Push-Mitteilungen & Kurzbefehle)
STELLA_PUBLIC_URL=https://stella.deinedomain.at
# Langer Zufallswert, verschlüsselt gespeicherte Passwörter (digi4school, E-Mail).
# Erzeugen mit:  openssl rand -base64 32
STELLA_SECRET=

# OpenRouter-Schlüssel: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------- Optional ----------
# Eigene Modell-Reihenfolge (kommagetrennt). Leer = Stella wählt automatisch die besten kostenlosen.
# STELLA_MODELS=
# Tageslimit für KI-Anfragen: 50 ohne Guthaben, 1000 nach einmal 10 $ bei OpenRouter aufladen.
# Hintergrund-Aufgaben (Mails sortieren) nutzen höchstens die Hälfte.
STELLA_LLM_DAILY_LIMIT=50
# Modelle, die Bilder lesen können (HÜ-Autopilot). Leer = automatisch die besten kostenlosen.
# STELLA_VISION_MODELS=
# Auch kostenpflichtige Modelle automatisch wählen? (Standard: nur kostenlose)
# STELLA_FREE_ONLY=true
STELLA_TIMEZONE=Europe/Vienna
# Nach dem ersten Konto weitere Registrierungen erlauben (z. B. für Familie)
STELLA_ALLOW_REGISTRATION=false
PORT=8787
