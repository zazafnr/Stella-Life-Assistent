{
  "name": "stella-mail",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // Vorschau-Adressen für PR-Branches (Cloudflare Workers Builds ruft dort `wrangler preview` auf, das diesen Block verlangt)
  "previews": {},
  "vars": {
    "STELLA_URL": "https://stella.evolsior.com"
  }
  // Geheimer Schlüssel: INBOUND_SECRET (Cloudflare → Workers → stella-mail → Settings → Variables and Secrets → Secret).
  // Den Schlüssel erzeugt Stella: Einstellungen → Server → „Mail an Stella“.
}
